#!/usr/bin/env bash
set -euo pipefail

ALLOWLIST="/etc/server-agent/allowed-services"
SYSTEMCTL="/usr/bin/systemctl"
JOURNALCTL="/usr/bin/journalctl"

if [[ "${EUID}" -ne 0 ]]; then
  echo "server-agent-hostctl must run as root through the reviewed sudoers rule." >&2
  exit 77
fi

action="${1:-}"
service="${2:-}"
if [[ ! "${service}" =~ ^[A-Za-z0-9@_.:-]{1,128}\.service$ ]]; then
  echo "Invalid service name." >&2
  exit 64
fi
if [[ ! -f "${ALLOWLIST}" ]] || ! /usr/bin/grep -Fxq -- "${service}" "${ALLOWLIST}"; then
  echo "Service is not present in the Server Agent host allowlist." >&2
  exit 77
fi

case "${action}" in
  status)
    [[ "$#" -eq 2 ]] || exit 64
    exec "${SYSTEMCTL}" is-active "${service}"
    ;;
  restart)
    [[ "$#" -eq 2 ]] || exit 64
    exec "${SYSTEMCTL}" restart "${service}"
    ;;
  logs)
    [[ "$#" -eq 3 ]] || exit 64
    lines="${3}"
    if [[ ! "${lines}" =~ ^[0-9]+$ ]] || (( lines < 1 || lines > 2000 )); then
      echo "Log line count must be 1-2000." >&2
      exit 64
    fi
    exec "${JOURNALCTL}" --unit "${service}" --no-pager --output=short-iso --lines "${lines}"
    ;;
  *)
    echo "Usage: server-agent-hostctl {status|restart|logs} SERVICE [LINES]" >&2
    exit 64
    ;;
esac
