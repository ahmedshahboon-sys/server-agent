SERVER_AGENT_DATA_DIR=/var/lib/server-agent
SERVER_AGENT_DB_PATH=/var/lib/server-agent/server-agent.sqlite
SERVER_AGENT_LOG_LEVEL=info
SERVER_AGENT_MAX_FILE_BYTES=1048576
SERVER_AGENT_MAX_COMMAND_OUTPUT_BYTES=262144
SERVER_AGENT_COMMAND_TIMEOUT_MS=120000
SERVER_AGENT_MAX_FIX_ATTEMPTS=3
SERVER_AGENT_MAX_CONCURRENT_JOBS=1
SERVER_AGENT_DATABASE_QUERY_TIMEOUT_MS=10000
SERVER_AGENT_DATABASE_MAX_ROWS=500
SERVER_AGENT_DATABASE_MAX_RESULT_BYTES=1048576
SERVER_AGENT_MAX_LOG_OUTPUT_BYTES=262144
SERVER_AGENT_MAX_RECOVERY_ATTEMPTS=3
SERVER_AGENT_MCP_HOST=127.0.0.1
SERVER_AGENT_MCP_PORT=8765
SERVER_AGENT_MCP_PATH=/mcp
SERVER_AGENT_MCP_MAX_BODY_BYTES=1048576
SERVER_AGENT_MCP_ALLOWED_ORIGINS=
SERVER_AGENT_MCP_ALLOW_PUBLIC_BIND=false
SERVER_AGENT_AUTH_ATTEMPTS_PER_MINUTE=30
SERVER_AGENT_AUTH_REQUESTS_PER_MINUTE=120
SERVER_AGENT_AUDIT_RETENTION_DAYS=30
SERVER_AGENT_OPERATIONAL_RETENTION_DAYS=30
SERVER_AGENT_JOB_LOG_RETENTION_DAYS=14
SERVER_AGENT_MIN_FREE_DISK_BYTES=268435456
SERVER_AGENT_STATE_DB_WARNING_BYTES=536870912
SERVER_AGENT_MAINTENANCE_MODE=false
SERVER_AGENT_HOST_HELPER_SOCKET=/run/server-agent-host/hostctl.sock
SERVER_AGENT_MCP_PRINCIPAL_ID=chatgpt-remote
SERVER_AGENT_MCP_CREDENTIAL_ID=bootstrap-chatgpt
SERVER_AGENT_MCP_CREDENTIAL_EXPIRES_AT=
SERVER_AGENT_MCP_PROJECT_SCOPES=example-project
SERVER_AGENT_MCP_PERMISSIONS=project:read,files:read,git:read,tasks:read,deploy:read,health:read,logs:read,service:read,recovery:read,rollback:read
SERVER_AGENT_MCP_BEARER_TOKEN=CHANGE_ME_WITH_32_PLUS_RANDOM_CHARACTERS
